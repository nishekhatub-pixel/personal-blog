NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1

DATABASE_URL="postgresql://r7_app:replace-this-password@127.0.0.1:5432/r7_blog?schema=public"
APP_URL="https://blog.example.com"
SESSION_SECRET="replace-with-at-least-32-random-characters"
IP_HASH_SECRET="replace-with-a-different-random-secret"

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-long-unique-password"

STORAGE_DRIVER=local
UPLOAD_ROOT="/var/www/r7-blog-storage"
UPLOAD_MAX_BYTES=104857600
AUDIO_UPLOAD_MAX_BYTES=104857600
